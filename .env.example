# Copy this file to .env and fill in your own values for local testing.
# In production these are GitHub Actions secrets/variables (see SETUP.md) —
# this file is never read by the workflow and is git-ignored so real
# values never get committed.

CANVAS_DOMAIN=yourschool.instructure.com
CANVAS_TOKEN=paste-your-canvas-access-token-here
NTFY_TOPIC=pick-a-long-random-topic-name
GEMINI_API_KEY=optional-free-key-from-aistudio.google.com
EXCLUDE_COURSE_IDS=
LOOKAHEAD_DAYS=7
